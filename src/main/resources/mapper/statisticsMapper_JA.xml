    <resultMap id="QuestionListResponseMap" type="com.kcc.fillin.statistic.dto.QuestionListResponse">
        <result property="surveySeq" column="survey_seq"/>
        <result property="participantSeq" column="participant_seq"/>
        <result property="independentQuestion" column="independent_question"/> <!-- 독립 질문 번호 매핑 -->
        <result property="dependentQuestion" column="dependent_question"/> <!-- 종속 질문 번호 매핑 -->
        <result property="independentQuestionItemSeq"
                column="independent_question_item_seq"/> <!-- 독립 질문 응답 항목 번호 매핑 -->
        <result property="dependentQuestionItemSeq" column="dependent_question_item_seq"/> <!-- 종속 질문 응답 항목 번호 매핑 -->
        <result property="content" column="content"/>
    </resultMap>
    <!--    question 1 => answer 여러개-->

    <select id="getQuestionAndAnswerByParticipant" parameterType="QuestionListRequest"
            resultMap="QuestionListResponseMap">
        SELECT
        q.survey_seq AS survey_seq,
        a.participant_seq AS participant_seq,
        CASE
        WHEN q.seq IN
        <foreach item="seq" collection="seqList" open="(" separator=", " close=")">
            #{seq}
        </foreach>
        THEN q.seq
        ELSE NULL
        END AS independent_question,
        #{dependentQuestion} AS dependent_question, -- 종속 질문 번호
        qi.seq AS independent_question_item_seq, -- 독립 질문에 대한 응답 항목 번호
        qi.content AS content,
        -- 종속 질문 항목에 대한 응답 항목 추가
        (SELECT di.seq
        FROM question_item di
        WHERE di.question_seq = #{dependentQuestion} -- 종속 질문 번호
        AND di.content = qi.content) AS dependent_question_item_seq
        FROM question q
        JOIN question_item qi ON q.seq = qi.question_seq
        JOIN answer a ON qi.content = a.contents
        WHERE q.survey_seq = #{surveySeq}
        AND (q.seq = #{dependentQuestion} OR q.seq IN
        <foreach item="seq" collection="seqList" open="(" separator=", " close=")">
            #{seq}
        </foreach>
        )
    </select>

    <resultMap id="ParticipantAnswerMap" type="ParticipantAnswer">
        <id property="participantSeq" column="participant_seq"/>
        <collection property="answers" ofType="QuestionAnswerRequest">
            <result property="questionSeq" column="question_seq"/>
            <result property="questionItemSeq" column="question_item_seq"/>
            <result property="contents" column="contents"/>
        </collection>
    </resultMap>

    <!-- 참여자별 질문과 응답 리스트 조회   -->
    <select id="getParticipantAnswers" resultMap="ParticipantAnswerMap">
        SELECT
            a.participant_seq,
            q.seq AS question_seq,
            a.seq AS question_item_seq,
            a.contents AS contents
        FROM answer a
--    JOIN question_item qi ON q.seq = qi.question_seq
                 join question q on q.seq = a.question_seq
--            JOIN answer a ON qi.content = a.contents
        WHERE q.survey_seq = #{surveySeq}
          and q.cc_seq in (select seq from common_code where parent_seq = 3 and seq != 8)
        ORDER BY a.participant_seq, q.seq
    </select>


    <resultMap id="responseMap" type="QuestionResponse">
        <result property="participantSeq" column="participant_seq"/>
        <result property="questionSeq" column="question_seq"/>
        <result property="questionItemSeq" column="question_item_seq"/>
        <result property="contents" column="contents"/>
    </resultMap>
    <!--  독립질문, 종속질문에 따른 참여자별 응답 조회  -->
    <select id="getResponsesByQuestions" resultMap="responseMap" parameterType="QuestionListRequest">
        SELECT a.participant_seq,
        q.seq AS question_seq,
        a.seq AS question_item_seq,
        a.contents AS contents
        FROM answer a
        JOIN question q ON q.seq = a.question_seq
        WHERE q.survey_seq = #{request.surveySeq}
        AND (
        q.seq = #{request.dependentQuestion} OR
        q.seq IN
        <foreach item="question" collection="request.independentQuestions" open="(" separator="," close=")">
            #{question}
        </foreach>
        )
        ORDER BY a.participant_seq, q.seq
    </select>

