    <!--  정량 평가 질문 가져오기  -->
    <select id="getQuantityQuestionsBySurvey" resultType="QuantityQuestionsResponse" parameterType="Long">
        SELECT s.seq  AS survey_seq,
               s.name AS surveyName,
               q.seq  AS question_seq,
               s.cc_seq,
               q.name AS questionName
        FROM survey s
                 JOIN question q
                      ON s.seq = q.survey_seq
        WHERE q.cc_seq IN (SELECT seq
                           FROM common_code
                           WHERE parent_seq = 3)
          AND s.seq = #{surveySeq}
    </select>

